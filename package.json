  },
  "dependencies": {
    "@expo-google-fonts/poppins": "0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "expo": "58.0.22",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "~6.0.3"
  }
}
